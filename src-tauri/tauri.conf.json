{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ControlVPS",
  "version": "1.10.1",
  "identifier": "com.controlvps.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ControlVPS",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "copyright": "Copyright © 2026 ControlVPS contributors",
    "category": "DeveloperTool",
    "license": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCRjNEN0Y3OEM1RUY0NzgKUldSNDlGNk05OWZ6NndGZm9yQzk0SDk0M3ZtVWlicmNUUFlENTJ1SE9mVEVRcDdqbGNXQ2IrTlQK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/1989tianlong/controlvps/releases/latest/download/latest.json"
      ]
    }
  }
}
